{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pawn-vs-all",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pawn-vs-all",
      "database_id": "9fc9827a-6f88-49c0-9e9a-cd41418f621b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WEBAPP_URL": "",
    "BOT_USERNAME": "pawn_vs_all_bot",
    "ALLOW_GUESTS": "true",
    "DEV_MODE": "false",
    "ADSGRAM_SRC": "https://sad.adsgram.ai/js/sad.min.js",
    "ADSGRAM_BLOCK_ID": ""
  },
  "observability": {
    "enabled": true
  }
}
